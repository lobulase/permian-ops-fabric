{
  "name": "ds_adls_landing_csv",
  "properties": {
    "linkedServiceName": {
      "referenceName": "ls_adls_landing",
      "type": "LinkedServiceReference"
    },
    "parameters": {
      "Folder": {
        "type": "string"
      },
      "FileName": {
        "type": "string"
      }
    },
    "type": "DelimitedText",
    "typeProperties": {
      "location": {
        "type": "AzureBlobFSLocation",
        "fileSystem": "landing",
        "folderPath": {
          "value": "@dataset().Folder",
          "type": "Expression"
        },
        "fileName": {
          "value": "@dataset().FileName",
          "type": "Expression"
        }
      },
      "columnDelimiter": ",",
      "escapeChar": "\\",
      "firstRowAsHeader": true,
      "quoteChar": "\""
    }
  }
}
