{
  "name": "ds_lakehouse_bronze_json",
  "properties": {
    "linkedServiceName": {
      "referenceName": "ls_fabric_lakehouse",
      "type": "LinkedServiceReference"
    },
    "parameters": {
      "IngestDate": {
        "type": "string"
      },
      "FileName": {
        "type": "string"
      }
    },
    "type": "Json",
    "typeProperties": {
      "location": {
        "type": "LakehouseLocation",
        "folderPath": {
          "value": "@concat('bronze/eia/spot_prices/ingest_date=', dataset().IngestDate)",
          "type": "Expression"
        },
        "fileName": {
          "value": "@dataset().FileName",
          "type": "Expression"
        }
      }
    }
  }
}
