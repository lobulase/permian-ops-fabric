        },
        "parameters": {
          "RunDate": "@trigger().scheduledTime"
        }
      }
    ],
    "type": "ScheduleTrigger",
    "typeProperties": {
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "startTime": "2026-11-02T05:30:00",
        "timeZone": "Central Standard Time",
        "schedule": {
          "hours": [
            5
          ],
          "minutes": [
            30
          ]
        }
      }
    }
  }
