{
  "name": "ls_fabric_lakehouse",
  "properties": {
    "description": "Microsoft Fabric Lakehouse 'lh_permian_ops' (OneLake). Bronze files land under Files/bronze.",
    "type": "Lakehouse",
    "typeProperties": {
      "workspaceId": "<fabric-workspace-id>",
      "artifactId": "<lakehouse-item-id>",
      "tenant": "<tenant-id>",
      "servicePrincipalId": "<spn-client-id>",
      "servicePrincipalCredentialType": "ServicePrincipalKey",
      "servicePrincipalCredential": {
        "type": "AzureKeyVaultSecret",
        "store": {
          "type": "LinkedServiceReference",
          "referenceName": "ls_keyvault"
        },
        "secretName": "fabric-spn-secret"
      }
    }
  }
}
